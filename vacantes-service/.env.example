# ── vacantes-service (funcionalidad adicional + backend de administración) ──
NODE_ENV=development
PORT=4100

# Supabase B — proyecto "vacantes" (Secret key o service_role, nunca la publishable/anon)
SUPABASE_VACANTES_URL=https://yyyyyyyyyyyy.supabase.co
SUPABASE_VACANTES_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Debe ser IGUAL a VACANTES_INTERNAL_KEY del BFF (mín. 24 caracteres)
INTERNAL_KEY=
# Debe ser IGUAL a ADMIN_GATEWAY_KEY del frontend (opcional en local)
GATEWAY_KEY=

ADMIN_SESSION_HOURS=8
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
TRUST_PROXY=1
LOG_LEVEL=info
