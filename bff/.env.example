# ── BFF (backend local) ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# API institucional (no cambiar)
SII_BASE_URL=https://sii.celaya.tecnm.mx/api
SII_TIMEOUT_MS=10000

# Supabase A — proyecto "core" (Settings → API Keys)
# Usa la Secret key (sb_secret_...) o la service_role legacy. NUNCA la publishable/anon.
SUPABASE_CORE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_CORE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Llave AES-256 para cifrar el JWT del SII. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENC_KEY=
SESSION_IDLE_MINUTES=20
SESSION_MAX_HOURS=8
# En local (http) debe ir en false; en Render se activa solo con NODE_ENV=production
COOKIE_SECURE=false

# vacantes-service (misma llave que su INTERNAL_KEY)
VACANTES_URL=http://localhost:4100
VACANTES_INTERNAL_KEY=

# Llave compartida con el gateway del frontend (opcional en local, obligatoria en Render)
GATEWAY_KEY=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
TRUST_PROXY=1
LOG_LEVEL=info
